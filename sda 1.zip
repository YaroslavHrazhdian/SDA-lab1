#include <string.h>
#include <stdlib.h>

#define MAX_TASKS 10
#define MAX_STR   100

// Структура "Задача"
typedef struct {
    char  name[MAX_STR];        // Название
    char  description[MAX_STR]; // Описание
    int   done;                 // Статус: 1 — выполнена, 0 — не выполнена
    char  deadline[MAX_STR];    // Срок завершения (формат ДД.ММ.ГГГГ)
} Task;

// Вспомогательная функция: безопасное чтение строки
static void read_line(const char *prompt, char *buf, int size) {
    printf("%s", prompt);
    fflush(stdout);
    if (fgets(buf, size, stdin)) {
        buf[strcspn(buf, "\n")] = '\0';
    }
}

// ─────────────────────────────────────────────────────────────
// 1. Заполнение массива
// ─────────────────────────────────────────────────────────────
int fill_tasks(Task tasks[], int *count) {
    char buf[8];
    printf("\n=== Заполнение задач ===\n");
    printf("Введите количество задач (1–%d): ", MAX_TASKS);
    fflush(stdout);
    if (!fgets(buf, sizeof(buf), stdin)) return 0;
    *count = atoi(buf);
    if (*count < 1 || *count > MAX_TASKS) {
        printf("Неверное количество.\n");
        return 0;
    }
    for (int i = 0; i < *count; i++) {
        printf("\n--- Задача %d ---\n", i + 1);
        read_line("  Название    : ", tasks[i].name,        MAX_STR);
        read_line("  Описание    : ", tasks[i].description, MAX_STR);
        read_line("  Срок (ДД.ММ.ГГГГ): ", tasks[i].deadline,  MAX_STR);

        printf("  Выполнена? (1 = да / 0 = нет): ");
        fflush(stdout);
        char s[8];
        fgets(s, sizeof(s), stdin);
        tasks[i].done = (atoi(s) == 1) ? 1 : 0;
    }
    return 1;
}

// ─────────────────────────────────────────────────────────────
// 2. Вывод всех задач
// ─────────────────────────────────────────────────────────────
void print_tasks(const Task tasks[], int count) {
    if (count == 0) { printf("\nСписок задач пуст.\n"); return; }
    printf("\n%-4s %-20s %-30s %-12s %s\n",
           "№", "Название", "Описание", "Срок", "Статус");
    printf("%-4s %-20s %-30s %-12s %s\n",
           "----", "--------------------",
           "------------------------------", "------------", "----------");
    for (int i = 0; i < count; i++) {
        printf("%-4d %-20s %-30s %-12s %s\n",
               i + 1,
               tasks[i].name,
               tasks[i].description,
               tasks[i].deadline,
               tasks[i].done ? "Выполнена" : "Не выполнена");
    }
}

// ─────────────────────────────────────────────────────────────
// 3. Редактирование задачи по индексу
// ─────────────────────────────────────────────────────────────
void edit_task(Task tasks[], int count) {
    if (count == 0) { printf("Список задач пуст.\n"); return; }
    char buf[8];
    printf("\nВведите номер задачи для редактирования (1–%d): ", count);
    fflush(stdout);
    fgets(buf, sizeof(buf), stdin);
    int idx = atoi(buf) - 1;
    if (idx < 0 || idx >= count) { printf("Неверный номер.\n"); return; }

    Task *t = &tasks[idx];
    int choice;
    do {
        printf("\n--- Редактирование задачи %d: \"%s\" ---\n", idx + 1, t->name);
        printf("  1. Название    : %s\n", t->name);
        printf("  2. Описание    : %s\n", t->description);
        printf("  3. Срок        : %s\n", t->deadline);
        printf("  4. Статус      : %s\n", t->done ? "Выполнена" : "Не выполнена");
        printf("  0. Назад\n");
        printf("Выберите поле: ");
        fflush(stdout);
        fgets(buf, sizeof(buf), stdin);
        choice = atoi(buf);
        switch (choice) {
            case 1: read_line("  Новое название: ", t->name, MAX_STR); break;
            case 2: read_line("  Новое описание: ", t->description, MAX_STR); break;
            case 3: read_line("  Новый срок (ДД.ММ.ГГГГ): ", t->deadline, MAX_STR); break;
            case 4:
                printf("  Выполнена? (1 = да / 0 = нет): ");
                fflush(stdout);
                fgets(buf, sizeof(buf), stdin);
                t->done = (atoi(buf) == 1) ? 1 : 0;
                break;
            case 0: break;
            default: printf("  Неверный выбор.\n");
        }
    } while (choice != 0);
    printf("Задача обновлена.\n");
}

// ─────────────────────────────────────────────────────────────
// 4. Поиск задачи по названию (подстрока, без учёта регистра)
// ─────────────────────────────────────────────────────────────
static int str_icontains(const char *hay, const char *needle) {
    // простой регистронезависимый поиск подстроки
    size_t nl = strlen(needle);
    for (size_t i = 0; hay[i]; i++) {
        size_t j;
        for (j = 0; j < nl; j++) {
            char a = hay[i + j], b = needle[j];
            if (a >= 'A' && a <= 'Z') a += 32;
            if (b >= 'A' && b <= 'Z') b += 32;
            if (a != b) break;
        }
        if (j == nl) return 1;
    }
    return 0;
}

void search_tasks(const Task tasks[], int count) {
    char keyword[MAX_STR];
    read_line("\nВведите часть названия для поиска: ", keyword, MAX_STR);
    int found = 0;
    printf("\nРезультаты поиска:\n");
    for (int i = 0; i < count; i++) {
        if (str_icontains(tasks[i].name, keyword)) {
            printf("  [%d] %s | %s | Срок: %s | %s\n",
                   i + 1,
                   tasks[i].name,
                   tasks[i].description,
                   tasks[i].deadline,
                   tasks[i].done ? "Выполнена" : "Не выполнена");
            found++;
        }
    }
    if (!found) printf("  Задачи не найдены.\n");
}

// ─────────────────────────────────────────────────────────────
// Главное меню
// ─────────────────────────────────────────────────────────────
int main(void) {
    Task tasks[MAX_TASKS];
    int  count = 0;
    char buf[8];
    int  choice;

    printf("========================================\n");
    printf("   Менеджер задач (Лабораторная №1)\n");
    printf("========================================\n");

    do {
        printf("\n--- МЕНЮ ---\n");
        printf("  1. Заполнить список задач\n");
        printf("  2. Вывести все задачи\n");
        printf("  3. Редактировать задачу\n");
        printf("  4. Найти задачу по названию\n");
        printf("  0. Выход\n");
        printf("Выбор: ");
        fflush(stdout);
        fgets(buf, sizeof(buf), stdin);
        choice = atoi(buf);

        switch (choice) {
            case 1: fill_tasks(tasks, &count);    break;
            case 2: print_tasks(tasks, count);    break;
            case 3: edit_task(tasks, count);      break;
            case 4: search_tasks(tasks, count);   break;
            case 0: printf("До свидания!\n");     break;
            default: printf("Неверный выбор.\n");
        }
    } while (choice != 0);

    return 0;
